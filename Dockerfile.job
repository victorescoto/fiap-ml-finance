# Dockerfile.job - Jobs de ML para AWS Lambda
FROM public.ecr.aws/lambda/python:3.11

# Instalar uv para gerenciamento de pacotes
RUN pip install --upgrade pip uv

# Copiar arquivos de configuração
COPY pyproject.toml ${LAMBDA_TASK_ROOT}/
COPY README.md ${LAMBDA_TASK_ROOT}/

# Copiar código da aplicação
COPY app/ ${LAMBDA_TASK_ROOT}/app/

# Instalar dependências usando pip com wheels pré-compilados (evita compilação)
RUN cd ${LAMBDA_TASK_ROOT} && pip install --no-cache-dir -e . --prefer-binary

# Definir handler genérico que roteia baseado no JOB_NAME do evento
CMD ["app.lambda_job_handler.handler"]
